        back.set_can_focus(False)
        back.connect("clicked", lambda *_a: self.close_preview())
        self.reveal_button = Gtk.ToggleButton(label=_("reveal"))
        self.reveal_button.set_can_focus(False)
        self.reveal_button.set_no_show_all(True)
        self.reveal_button.connect("toggled", self._on_reveal_toggled)
        paste = Gtk.Button(label=_("paste_btn"))
        paste.set_can_focus(False)
        paste.get_style_context().add_class("suggested-action")
        paste.connect("clicked", lambda *_a: self._paste_preview_now())
        buttons.pack_start(back, False, False, 0)
        buttons.pack_start(self.reveal_button, False, False, 0)
        buttons.pack_end(paste, False, False, 0)
        page.pack_start(buttons, False, False, 0)
        return page

    def _preview_text(self, item):
        """(text to show, may it be edited)"""
        text = item.text
        if item.category == "sensitive" and not self.revealed:
            shown = masked_text(text[:ANALYSE_CHARS], item.spans)
            return shown + (" …" if len(text) > ANALYSE_CHARS else ""), False
        if len(text) > self.PREVIEW_LIMIT:
            return text[:self.PREVIEW_LIMIT], False
        return text, True

    def open_preview(self, item_id):
        item = self.app.store.get(item_id)
        if item is None:
            return
        self.preview_item = item
        self.revealed = False
        self.preview_view = None
        child = self.preview_scroll.get_child()
        if child is not None:
            self.preview_scroll.remove(child)
        details = [_("cat_" + item.category)] if item.category != "text" else []
        details.append(relative_time(item.ts))
        self.preview_meta.set_text("  ·  ".join(part for part in details if part))
        self.reveal_button.set_active(False)
        self.reveal_button.set_label(_("reveal"))
        note = ""
        if item.kind == "image":
            try:
                pixbuf = GdkPixbuf.Pixbuf.new_from_file(item.path)
                width = self.WIDTH - 56
                if pixbuf.get_width() > width:
                    height = max(1, pixbuf.get_height() * width // pixbuf.get_width())
                    pixbuf = pixbuf.scale_simple(width, height, GdkPixbuf.InterpType.BILINEAR)
                content = Gtk.Image.new_from_pixbuf(pixbuf)
                content.set_halign(Gtk.Align.START)
                content.set_valign(Gtk.Align.START)
            except GLib.Error:
                content = Gtk.Label(label=_("image"))
            self.preview_scroll.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
            self.reveal_button.hide()
        else:
            view = Gtk.TextView()
            view.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
            for side in ("left", "right", "top", "bottom"):
                getattr(view, "set_%s_margin" % side)(10 if side in ("left", "right") else 8)
            view.get_style_context().add_class("superv-previewtext")
            if item.category == "code":
                view.set_monospace(True)
            self.preview_view = view
            self._fill_preview(item)
            content = view
            self.preview_scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
            if item.category == "sensitive":
                self.reveal_button.show()
            else:
                self.reveal_button.hide()
            note = _("truncated") if len(item.text) > self.PREVIEW_LIMIT else \
                (_("preview_note") if item.category != "sensitive" else "")
        self.preview_note.set_text(note)
        self.preview_scroll.add(content)
        content.show_all()
        self.gear.set_sensitive(False)
        self.clear_button.set_sensitive(False)
        self.stack.set_visible_child_name("preview")
        self.hint.set_text(_("hint_preview"))
        if self.preview_view is not None:
            self.preview_view.grab_focus()

    def _fill_preview(self, item):
        shown, editable = self._preview_text(item)
        self.preview_view.get_buffer().set_text(shown)
        self.preview_view.set_editable(editable)
        self.preview_view.set_cursor_visible(editable)

    def _on_reveal_toggled(self, button):
        if self.preview_item is None or self.preview_view is None:
            return
        self.revealed = button.get_active()
        button.set_label(_("hide_secret") if self.revealed else _("reveal"))
        self._fill_preview(self.preview_item)

    def close_preview(self):
        if self.preview_item is None:
            return
        self.preview_item = None
        self.preview_view = None
        self.stack.set_visible_child_name("list")
        self.gear.set_sensitive(True)
        self.rebuild()
        self.search.grab_focus_without_selecting()

    def _paste_preview_now(self):
        item = self.preview_item
        if item is None:
            return
        view = self.preview_view
        if view is not None and view.get_editable():
            buffer = view.get_buffer()
            text = buffer.get_text(buffer.get_start_iter(), buffer.get_end_iter(), True)
            if text.strip() and text != item.text:
                self.app.paste_text(text)      # edited: pasted as plain text, kept as a new entry
                return
        self.app.paste_item(item.id)

    def _on_preview_key(self, key, ctrl):
        if key == Gdk.KEY_Escape:
            self.close_preview()
            return True
        if ctrl and key in (Gdk.KEY_Return, Gdk.KEY_KP_Enter, Gdk.KEY_ISO_Enter):
            self._after_ctrl_up(self._paste_preview_now)
            return True
        return False          # everything else is typing into the text

    # -- dragging ---------------------------------------------------------

    def _make_draggable(self, widget):
        """Dragging the header or the footer moves the panel."""
        widget.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
        widget.connect("button-press-event", self._on_drag_press)

    def _on_drag_press(self, _widget, event):
        if event.button == 1 and event.type == Gdk.EventType.BUTTON_PRESS:
            self.dragged = True
            self.begin_move_drag(event.button, int(event.x_root), int(event.y_root), event.time)
            return True
        return False

    def _on_configure(self, _widget, event):
        self.moved_at = time.monotonic()
        if self.dragged and self.get_visible() and self.app.cfg["remember_position"]:
            self._remember(event.x, event.y)
        return False

    def _remember(self, x, y):
        """Store where the user dragged the panel, relative to the monitor it is on."""
        width, height = self.WIDTH + 2 * self.pad, self.HEIGHT + 2 * self.pad
        monitor = self.get_display().get_monitor_at_point(x + width // 2, y + height // 2)
        if monitor is None:
            return
        geo = monitor.get_geometry()
        self.app.state["positions"][monitor_key(monitor)] = [x - geo.x, y - geo.y]
        if not self._state_source:
            self._state_source = GLib.timeout_add(600, self._save_state)

    def _save_state(self):
        self._state_source = 0
        save_state(self.app.state)
        return False

    def _remembered(self, monitor):
        if not self.app.cfg["remember_position"]:
            return None
        saved = self.app.state["positions"].get(monitor_key(monitor))
        if isinstance(saved, list) and len(saved) == 2 and \
                all(isinstance(value, (int, float)) for value in saved):
            geo = monitor.get_geometry()
            return geo.x + int(saved[0]), geo.y + int(saved[1])
        return None

    # -- tabs -------------------------------------------------------------

    def _on_tab_toggled(self, button, tab):
        if button.get_active() and tab != self.tab:
            self.tab = tab
            self.listbox.unselect_all()
            self.rebuild()
            self.scroller.get_vadjustment().set_value(0)

    def _switch_tab(self, step):
        index = (self.TABS.index(self.tab) + step) % len(self.TABS)
        self.tab_buttons[self.TABS[index]].set_active(True)

    # -- list -------------------------------------------------------------

    def _preview(self, text):
        text = text[:4000]
        lines = [line.rstrip() for line in text.strip("\n").expandtabs(4).split("\n")]
        lines = [line for line in lines if line.strip()] or [""]
        indent = min(len(line) - len(line.lstrip()) for line in lines)
        clipped = [line[indent:] for line in lines[:self.PREVIEW_LINES]]
        preview = "\n".join(clipped)[:self.PREVIEW_CHARS]
        if len(lines) > self.PREVIEW_LINES:
            preview += " …"
        return preview

    def _thumbnail(self, item):
        if item.id not in self.thumbs:
            try:
                self.thumbs[item.id] = GdkPixbuf.Pixbuf.new_from_file_at_scale(
                    item.path, self.WIDTH - 110, 130, True)
            except GLib.Error:
                self.thumbs[item.id] = None
        return self.thumbs[item.id]

    def _icon_button(self, icon, tooltip, callback, item_id):
        button = Gtk.Button.new_from_icon_name(icon, Gtk.IconSize.MENU)
        button.set_relief(Gtk.ReliefStyle.NONE)
        button.set_can_focus(False)
        button.set_tooltip_text(tooltip)
        button.set_valign(Gtk.Align.START)
        button.connect("clicked", lambda *_a: callback(item_id))
        return button

    def _make_row(self, item, number):
        row = Gtk.ListBoxRow()
        row.item_id = item.id
        card = Gtk.Box(spacing=7)
        card.get_style_context().add_class("superv-card")

        badge = Gtk.Label(label=str(number) if number <= 9 else "")
        badge.set_valign(Gtk.Align.START)
        badge.get_style_context().add_class("superv-badge")
        card.pack_start(badge, False, False, 0)

        if item.kind == "image":
            thumb = self._thumbnail(item)
            if thumb is not None:
                content = Gtk.Image.new_from_pixbuf(thumb)
                content.get_style_context().add_class("superv-thumb")
            else:
                content = Gtk.Label(label=_("image"))
            content.set_halign(Gtk.Align.START)
        else:
            content = Gtk.Label(xalign=0, yalign=0)
            content.set_text(self._preview(item.display_text))
            content.set_line_wrap(True)
            content.set_line_wrap_mode(Pango.WrapMode.WORD_CHAR)
            content.set_lines(self.PREVIEW_LINES)
            content.set_ellipsize(Pango.EllipsizeMode.END)
            content.set_max_width_chars(10)
        details = [_("cat_" + item.category)] if item.category != "text" else []
        if item.html:
            details.append(_("cat_rich"))
        details.append(relative_time(item.ts))
        meta = Gtk.Label(label="  ·  ".join(part for part in details if part), xalign=0)
        meta.get_style_context().add_class("superv-meta")
        body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
        body.pack_start(content, True, True, 0)
        body.pack_start(meta, False, False, 0)
        card.pack_start(body, True, True, 0)

        buttons = Gtk.Box(spacing=0)
        buttons.set_valign(Gtk.Align.START)
        if item.kind == "text" and item.html:
            plain_default = not self.app.cfg["paste_formatted"]
            buttons.pack_start(self._icon_button(
                "superv-format-symbolic", _("fmt_with") if plain_default else _("fmt_without"),
                lambda item_id: self.app.paste_item(item_id, formatted=plain_default), item.id),
                False, False, 0)
        pin = self._icon_button("superv-pin-symbolic", _("unpin") if item.pinned else _("pin"),
                                self.app.store.toggle_pin, item.id)
        if item.pinned:
            pin.get_style_context().add_class("superv-pinned")
        buttons.pack_start(pin, False, False, 0)
        buttons.pack_start(self._icon_button("superv-delete-symbolic", _("delete"),
                                             self.app.store.remove, item.id), False, False, 0)
        card.pack_end(buttons, False, False, 0)
        row.add(card)
        row.show_all()
        return row

    def rebuild(self):
        selected = self.listbox.get_selected_row()
        keep_id = selected.item_id if selected else None
        for child in self.listbox.get_children():
            self.listbox.remove(child)
        query = self.search.get_text().strip().lower()
        items = self.app.store.items
        if self.tab != "all":
            items = [i for i in items if i.category == self.tab]
        if query:
            items = [i for i in items if i.kind == "text" and query in i.text.lower()]
        live = {i.id for i in self.app.store.items}
        self.thumbs = {k: v for k, v in self.thumbs.items() if k in live}
        choose = None
        for number, item in enumerate(items, 1):
            row = self._make_row(item, number)
            self.listbox.add(row)
            if item.id == keep_id:
                choose = row
        self.placeholder.set_text(_("no_match") if query else
                                  _("empty") if self.tab == "all" else _("empty_tab"))
        self.clear_button.set_sensitive(any(not i.pinned for i in self.app.store.items))
        if self.preview_item is None:
            self.hint.set_text(_("hint") if self.app.can_paste() else _("hint_copy_only"))
        self._select(choose or self.listbox.get_row_at_index(0))

    def _select(self, row):
        if row is None:
            return
        self.listbox.select_row(row)
        GLib.idle_add(self._scroll_to, row)

    def _scroll_to(self, row):
        if row.get_parent() is None:
            return False
        alloc = row.get_allocation()
        adj = self.scroller.get_vadjustment()
        if alloc.y < adj.get_value():
            adj.set_value(alloc.y)
        elif alloc.y + alloc.height > adj.get_value() + adj.get_page_size():
            adj.set_value(alloc.y + alloc.height - adj.get_page_size())
        return False

    def _move(self, step):
        rows = self.listbox.get_children()
        if not rows:
            return
        current = self.listbox.get_selected_row()
        index = rows.index(current) if current in rows else -1
        self._select(rows[max(0, min(len(rows) - 1, index + step))])

    # -- events -----------------------------------------------------------

    def _on_key(self, _widget, event):
        key = event.keyval
        ctrl = bool(event.state & Gdk.ModifierType.CONTROL_MASK)
        if self.preview_item is not None:
            return self._on_preview_key(key, ctrl)
        row = self.listbox.get_selected_row()
        if key == Gdk.KEY_Escape:
            if self.search.get_text():
                self.search.set_text("")
            else:
                self.hide()
            return True
        if key in (Gdk.KEY_Up, Gdk.KEY_KP_Up):
            self._move(-1)
            return True
        if key in (Gdk.KEY_Down, Gdk.KEY_KP_Down):
            self._move(1)
            return True
        if key in (Gdk.KEY_Page_Up, Gdk.KEY_KP_Page_Up):
            self._move(-4)
            return True
        if key in (Gdk.KEY_Page_Down, Gdk.KEY_KP_Page_Down):
            self._move(4)
            return True
        if key == Gdk.KEY_space and not self.search.get_text():
            if row is not None:
                self.open_preview(row.item_id)
            return True          # (once something is typed, Space is just a space)
        if key in (Gdk.KEY_Return, Gdk.KEY_KP_Enter, Gdk.KEY_ISO_Enter):
            if row is not None:
                other = bool(event.state & Gdk.ModifierType.SHIFT_MASK)   # Shift+Enter: the other way
                self.app.paste_item(row.item_id, (not self.app.cfg["paste_formatted"]) if other else None)
            return True
        if key in (Gdk.KEY_Delete, Gdk.KEY_KP_Delete) and not self.search.get_text():
            if row is not None:
                self._remove_keeping_position(row)
            return True
        if ctrl and key in (Gdk.KEY_p, Gdk.KEY_P):
            if row is not None:
                self.app.store.toggle_pin(row.item_id)
            return True
        if ctrl and (Gdk.KEY_1 <= key <= Gdk.KEY_9 or Gdk.KEY_KP_1 <= key <= Gdk.KEY_KP_9):
            self._quick_pick(key - (Gdk.KEY_1 if key <= Gdk.KEY_9 else Gdk.KEY_KP_1))
            return True
        if ctrl and key in (Gdk.KEY_Tab, Gdk.KEY_ISO_Left_Tab):
            self._switch_tab(-1 if key == Gdk.KEY_ISO_Left_Tab else 1)
            return True
        if key in (Gdk.KEY_Left, Gdk.KEY_Right) and not self.search.get_text():
            self._switch_tab(-1 if key == Gdk.KEY_Left else 1)
            return True
        if not self.search.is_focus():
            self.search.grab_focus_without_selecting()
        return False

    def _quick_pick(self, index):
        """Ctrl+1..9. Counts the entries of the list on screen - including those
        scrolled out of view. If that list is shorter (another tab, a search),
        the number counts the whole history instead, so the key always does something."""
        row = self.listbox.get_row_at_index(index)
        if row is not None:
            item_id = row.item_id
            self._select(row)
        elif index < len(self.app.store.items):
            item_id = self.app.store.items[index].id
        else:
            return
        self._after_ctrl_up(lambda: self.app.paste_item(item_id))

    def _after_ctrl_up(self, action):
        """Pasting while Ctrl is still held would turn the paste shortcut into
        Ctrl+Shift+Insert, which most programs ignore: wait until Ctrl is up."""
        if self.pending_action is None:
            GLib.timeout_add(25, self._poll_ctrl, time.monotonic())
        self.pending_action = action

    def _ctrl_down(self):
        try:
            keymap = Gdk.Keymap.get_for_display(self.get_display())
            return bool(keymap.get_modifier_state() & Gdk.ModifierType.CONTROL_MASK)
        except (AttributeError, TypeError):
            return False

    def _run_pending(self):
        action, self.pending_action = self.pending_action, None
        if action is not None:
            action()

    def _poll_ctrl(self, started):
        if self.pending_action is None:
            return False
        if self._ctrl_down() and time.monotonic() - started < 5:
            return True
        self._run_pending()
        return False

    def _on_key_release(self, _widget, event):
        if self.pending_action is not None and event.keyval in (Gdk.KEY_Control_L, Gdk.KEY_Control_R):
            self._run_pending()
            return True
        return False

    def _on_hidden(self, *_args):
        self.pending_action = None

    def _remove_keeping_position(self, row):
        rows = self.listbox.get_children()
        index = rows.index(row)
        neighbour = rows[index + 1] if index + 1 < len(rows) else (rows[index - 1] if index else None)
        if neighbour is not None:
            self.listbox.select_row(neighbour)
        self.app.store.remove(row.item_id)

    def _on_focus_out(self, *_args):
        GLib.timeout_add(90, self._hide_if_inactive)
        return False

    def _hide_if_inactive(self):
        if self.get_visible() and not self.is_active() and \
                time.monotonic() - self.shown_at > 0.35 and \
                time.monotonic() - self.moved_at > 0.6:
            self.hide()
        return False

    # -- show / hide ------------------------------------------------------

    def _server_time(self):
        gdk_window = self.get_window()
        if GdkX11 is not None and isinstance(gdk_window, GdkX11.X11Window):
            # A fresh X server timestamp lets the window manager give us focus
            # although the request does not come from a click in our own window.
            stamp = GdkX11.x11_get_server_time(gdk_window)
            gdk_window.set_user_time(stamp)
            return stamp
        return Gdk.CURRENT_TIME

    def _pointer_monitor(self, display):
        try:
            _screen, px, py = display.get_default_seat().get_pointer().get_position()
            return display.get_monitor_at_point(px, py), px, py
        except (AttributeError, TypeError):
            return None, None, None

    def _focused_monitor(self, display):
        """Monitor of the window the user is working in (X11 sessions)."""
        try:
            active = self.get_screen().get_active_window()
            if active is not None:
                return display.get_monitor_at_window(active)
        except (AttributeError, TypeError, GLib.Error):
            pass
        return None

    def _position_on(self, monitor, px=None, py=None):
        """Top-left of the window on the given monitor (centred, or at the pointer)."""
        width, height = self.WIDTH + 2 * self.pad, self.HEIGHT + 2 * self.pad
        area = monitor.get_workarea()
        saved = self._remembered(monitor)
        if saved is not None:
            x, y = saved
        elif px is not None and area.x <= px < area.x + area.width and \
                area.y <= py < area.y + area.height:
            x, y = px - self.pad - 24, py - self.pad - 24
        else:
            x = area.x + (area.width - width) // 2
            y = area.y + (area.height - height) // 2
        x = max(area.x - self.pad, min(x, area.x + area.width - width + self.pad))
        y = max(area.y - self.pad, min(y, area.y + area.height - height + self.pad))
        return x, y

    def _target_position(self):
        """X11 sessions: the monitor with the focused window, else the pointer's."""
        display = self.get_display()
        pointer_monitor, px, py = self._pointer_monitor(display)
        at_pointer = self.app.cfg["position"] == "pointer"
        monitor = pointer_monitor if at_pointer else self._focused_monitor(display)
        monitor = monitor or pointer_monitor or display.get_primary_monitor() or display.get_monitor(0)
        return self._position_on(monitor, px if at_pointer else None, py)

    def popup(self):
        if self._probing:
            return
        self.dragged = False
        self.pending_action = None
        self.preview_item = None
        self.preview_view = None
        self.stack.set_visible_child_name("list")
        self.gear.set_sensitive(True)
        self.app.store.expire()
        self.search.set_text("")
        self.listbox.unselect_all()
        self.tab = "all"
        self.tab_buttons["all"].set_active(True)
        self.rebuild()
        self.scroller.get_vadjustment().set_value(0)
        self.realize()
        if session_is_wayland():
            # An X11 client cannot see the pointer or the focus once they are
            # over a native Wayland window, but the compositor puts every new
            # window on the monitor you are on. An invisible 1x1 window finds
            # that monitor first; the panel is then shown once, in its place.
            self._probe_monitor(self._show_on_monitor)
        else:
            self._show_at(self._target_position())

    def _probe_monitor(self, done):
        self._probing = True
        probe = Gtk.Window(title=APP_NAME + " probe")
        probe.set_decorated(False)
        probe.set_skip_taskbar_hint(True)
        probe.set_skip_pager_hint(True)
        probe.set_accept_focus(False)
        probe.set_focus_on_map(False)
        probe.set_default_size(1, 1)
        visual = probe.get_screen().get_rgba_visual()
        if visual is not None:
            probe.set_visual(visual)
        probe.set_app_paintable(True)      # nothing is drawn: fully transparent
        probe.set_opacity(0)
        state = {"done": False}

        def finish():
            if state["done"]:
                return False
            state["done"] = True
            monitor = None
            try:
                if probe.get_window() is not None:
                    monitor = self.get_display().get_monitor_at_window(probe.get_window())
            except (AttributeError, TypeError, GLib.Error):
                pass
            probe.destroy()
            self._probing = False
            done(monitor)
            return False

        probe.connect("map-event", lambda *_a: GLib.timeout_add(35, finish) and False)
        GLib.timeout_add(300, finish)      # in case no map event arrives
        probe.show()

    def _show_on_monitor(self, monitor):
        display = self.get_display()
        monitor = monitor or self._pointer_monitor(display)[0] or \
            display.get_primary_monitor() or display.get_monitor(0)
        self._show_at(self._position_on(monitor))

    def _show_at(self, target):
        """Map the panel at its final place; it stays invisible until it is there."""
        self.shown_at = time.monotonic()
        self.move(*target)
        self.set_opacity(0)
        stamp = self._server_time()
        self.show()
        self.present_with_time(stamp)
        self.search.grab_focus_without_selecting()
        GLib.timeout_add(25, self._reveal, tuple(target), 0)
        GLib.timeout_add(450, self._retry_focus)

    def _reveal(self, target, attempt):
        gdk_window = self.get_window()
        if not self.get_visible() or gdk_window is None:
            self.set_opacity(1)
            return False
        if not gdk_window.is_visible() and attempt < 6:
            GLib.timeout_add(25, self._reveal, target, attempt + 1)
            return False
        if tuple(self.get_position()) != target and attempt < 90:
            # The window manager put it somewhere else (for instance back where
            # it was dragged to earlier): correct that once, then show it.
            gdk_window.move(*target)
            GLib.timeout_add(30, self._reveal, target, 90)
            return False
        self.set_opacity(1)
        return False

    def _retry_focus(self):
        if self.get_visible() and not self.is_active():
            self.present_with_time(self._server_time())
        return False


