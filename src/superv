    return STRINGS[_LANG].get(key, STRINGS["en"][key])


def log(*parts):
    print("superv:", *parts, file=sys.stderr, flush=True)


# --------------------------------------------------------------- config ----

def load_config():
    cfg = dict(DEFAULT_CONFIG)
    try:
        with open(CONFIG_FILE, encoding="utf-8") as handle:
            user = json.load(handle)
        if isinstance(user, dict):
            for key, default in DEFAULT_CONFIG.items():
                if key in user and isinstance(user[key], type(default)):
                    cfg[key] = user[key]
    except FileNotFoundError:
        try:
            os.makedirs(CONFIG_DIR, mode=0o700, exist_ok=True)
            with open(CONFIG_FILE, "w", encoding="utf-8") as handle:
                json.dump(DEFAULT_CONFIG, handle, indent=2)
                handle.write("\n")
        except OSError as err:
            log("could not write default config:", err)
    except (OSError, ValueError) as err:
        log("ignoring unreadable config:", err)
    cfg["max_items"] = max(1, min(int(cfg["max_items"]), 500))
    cfg["expire_days"] = max(0, min(int(cfg["expire_days"]), 3650))
    return cfg


def _write_json(path, data):
    try:
        os.makedirs(CONFIG_DIR, mode=0o700, exist_ok=True)
        fd = os.open(path + ".tmp", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(data, handle, indent=2)
            handle.write("\n")
        os.replace(path + ".tmp", path)
    except OSError as err:
        log("could not write %s:" % path, err)


def save_config(cfg):
    _write_json(CONFIG_FILE, {key: cfg[key] for key in DEFAULT_CONFIG})


def load_state():
    """Things the program remembers by itself (panel position per monitor)."""
    try:
        with open(STATE_FILE, encoding="utf-8") as handle:
            state = json.load(handle)
    except (OSError, ValueError):
        state = {}
    if not isinstance(state, dict):
        state = {}
    if not isinstance(state.get("positions"), dict):
        state["positions"] = {}
    return state


def save_state(state):
    _write_json(STATE_FILE, state)


# -------------------------------------------------------- classification ----
# Every text entry lands in exactly one tab: sensitive > code > text.
# All of this is pattern matching - it can miss things and it can be wrong.

ANALYSE_CHARS = 20000

_SECRET_BLOCKS = (
    re.compile(r"-----BEGIN [A-Z0-9 ]*PRIVATE KEY-----.*?(?:-----END [A-Z0-9 ]*PRIVATE KEY-----|\Z)", re.S),
    re.compile(r"\b(?:gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|glpat-[A-Za-z0-9_\-]{20,}"
               r"|sk-[A-Za-z0-9_\-]{20,}|xox[abprs]-[A-Za-z0-9\-]{10,}|AKIA[0-9A-Z]{16}"
               r"|AIza[0-9A-Za-z_\-]{35})"),
    re.compile(r"\beyJ[A-Za-z0-9_\-]{8,}\.[A-Za-z0-9_\-]{8,}\.[A-Za-z0-9_\-]{4,}"),   # JWT
)
_SECRET_WORD = r"(?:pass(?:word|wort|wd|phrase)?|pwd|kennwort|secret|token|api[_-]?key|auth[_-]?key" \
               r"|access[_-]?key|private[_-]?key)"
# password: hunter2   /   DB_PASSWORD=hunter2   /   "apiKey": "abc123"
_SECRET_ASSIGN = re.compile(r"(?i)" + _SECRET_WORD + r"[a-z0-9_]*[\"']?\s*(?:=>|[:=])\s*[\"']?"
                            r"([^\s\"',;)]{4,})")
# define('DB_PASSWORD', 'hunter2');   define('AUTH_KEY', '...');
_SECRET_DEFINE = re.compile(r"(?i)[\"'][a-z0-9_]*(?:pass|secret|key|salt|token)[a-z0-9_]*[\"']\s*,"
                            r"\s*[\"']([^\"']{4,})[\"']")
_SECRET_URL = re.compile(r"\b[a-z][a-z0-9+.\-]*://[^\s/:@]+:([^\s/@]+)@")
_IBAN = re.compile(r"\b[A-Z]{2}\d{2}(?: ?[A-Z0-9]{4}){2,7}(?: ?[A-Z0-9]{1,3})?\b")
_CARD = re.compile(r"(?<![\d.,])[3-6]\d(?:[ -]?\d){11,17}(?![\d.,])")
_NOT_A_SECRET = {"true", "false", "null", "none", "undefined", "string", "text", "password",
                 "passwort", "required", "optional", "empty", "hidden", "bool", "boolean"}


def _iban_ok(candidate):
    iban = candidate.replace(" ", "")
    if not 15 <= len(iban) <= 34:
        return False
    digits = "".join(str(int(ch, 36)) for ch in iban[4:] + iban[:4])
    return int(digits) % 97 == 1


def _luhn_ok(candidate):
    digits = [int(ch) for ch in candidate if ch.isdigit()]
    if not 13 <= len(digits) <= 19:
        return False
    total = 0
    for index, digit in enumerate(reversed(digits)):
        if index % 2:
            digit = digit * 2 - 9 if digit > 4 else digit * 2
        total += digit
    return total % 10 == 0


def _looks_like_password(token):
    """A lone string that looks typed-as-a-password or like a random key.

    "_", "-" and "." do not count as password symbols: names such as
    Mobile_pos2, jm-adblock-v2 or Report_v2.docx are identifiers, not secrets.
    """
    if not 8 <= len(token) <= 72 or re.search(r"\s", token):
        return False
    if "://" in token or token.startswith(("/", "~", "./", "www.", "#", "@")):
        return False
    if re.fullmatch(r"[\w.+\-]+@[\w\-]+(?:\.[\w\-]+)+", token):      # e-mail address
        return False
    lower = sum(ch.islower() for ch in token)
    upper = sum(ch.isupper() for ch in token)
    digit = sum(ch.isdigit() for ch in token)
    symbol = sum(not ch.isalnum() and ch not in "_-." for ch in token)
    if lower and upper and digit and symbol:
        return True
    # Long random keys (base62 / base64): unlike names, they are dense in capitals
    # and digits and keep switching between kinds of characters.
    if len(token) < 24 or not (lower and upper and digit) or \
            not re.fullmatch(r"[A-Za-z0-9_\-+/=]+", token):
        return False
    kinds = ["l" if ch.islower() else "u" if ch.isupper() else "d" if ch.isdigit() else "s"
             for ch in token]
    switches = sum(1 for left, right in zip(kinds, kinds[1:]) if left != right)
    return (upper + digit) >= 0.4 * len(token) and switches >= 0.35 * (len(token) - 1)


def find_secrets(text):
    """Character ranges of the text that should not be shown in full."""
    spans = []
    for pattern in _SECRET_BLOCKS:
        spans += [match.span() for match in pattern.finditer(text)]
    for pattern in (_SECRET_ASSIGN, _SECRET_DEFINE):
        for match in pattern.finditer(text):
            value = match.group(1)
            if value.lower() in _NOT_A_SECRET or value[0] in "$<({[" or "(" in value:
                continue
            spans.append(match.span(1))
    spans += [match.span(1) for match in _SECRET_URL.finditer(text)]
    spans += [match.span() for match in _IBAN.finditer(text) if _iban_ok(match.group())]
    spans += [match.span() for match in _CARD.finditer(text) if _luhn_ok(match.group())]
    stripped = text.strip()
    if not spans and _looks_like_password(stripped):
        start = text.index(stripped)
        spans.append((start, start + len(stripped)))
    merged = []
    for start, end in sorted(spans):
        if merged and start <= merged[-1][1]:
            merged[-1] = (merged[-1][0], max(end, merged[-1][1]))
        else:
            merged.append((start, end))
    return tuple(merged)


def mask(secret):
    """hunter2secret -> hu••••••••et : enough to recognise it, not enough to read it."""
    if "\n" in secret:
        return "•" * 12
    if len(secret) <= 5:
        return "•" * len(secret)
    keep = 2 if len(secret) < 16 else 4
    return secret[:keep] + "•" * min(len(secret) - 2 * keep, 12) + secret[-keep:]


def masked_text(text, spans):
    parts, position = [], 0
    for start, end in spans:
        parts += [text[position:start], mask(text[start:end])]
        position = end
    parts.append(text[position:])
    return "".join(parts)


_SHELL_COMMANDS = {
    "sudo", "apt", "apt-get", "dpkg", "snap", "flatpak", "git", "cd", "ls", "cp", "mv", "rm", "mkdir",
    "chmod", "chown", "cat", "grep", "sed", "awk", "find", "tar", "unzip", "zip", "curl", "wget",
    "ssh", "scp", "rsync", "docker", "kubectl", "npm", "npx", "yarn", "pnpm", "node", "pip", "pip3",
    "python", "python3", "php", "composer", "wp", "mysql", "mariadb", "mysqldump", "mariadb-dump",
    "systemctl", "journalctl", "service", "export", "echo", "make", "bash", "sh", "source", "kill",
    "pkill", "killall", "ps", "df", "du", "ln", "touch", "nano", "vim", "gsettings", "dconf", "superv",
}
# Commands that are not also everyday words: "killall firefox" needs no option
# flag to count as a command, "find the file" does.
_SHELL_UNMISTAKABLE = {
    "sudo", "apt", "apt-get", "dpkg", "flatpak", "killall", "pkill", "systemctl", "journalctl",
    "chmod", "chown", "mkdir", "npm", "npx", "pnpm", "pip", "pip3", "wget", "curl", "ssh", "scp",
    "rsync", "docker", "kubectl", "gsettings", "dconf", "mysqldump", "mariadb-dump", "composer",
    "unzip", "grep", "sed", "awk", "superv",
}
_CODE_LINE = re.compile(r"""
      ^\s*(?:def|class|function|import|from|const|let|var|return|if|elif|else|for|foreach|while
            |switch|case|try|catch|public|private|protected|static|echo|print|namespace|use
            |package|func|fn|struct|enum|interface|export|async|await
            |SELECT|INSERT|UPDATE|DELETE|CREATE|ALTER|DROP)\b.*[({:;=\[*]
    | [;{}]\s*$
    | ^\s*[)}\]]+[;,]?\s*$
    | =>|\w->\w|\w::\w|===?|!==?|&&|\|\||\+=|-=|<\?php|\?>
    | </?[a-zA-Z][\w\-]*(?:\s[^<>]*)?/?>
    | ^\s*(?://|/\*|\*/|<!--)
    | ^\s*[\w$.\[\]'"]+\s*=\s*\S
    | ^\s*[.\#]?[\w\-]+(?:\s*[,>+~ ]\s*[.\#]?[\w\-]+)*\s*\{
    | ^\s*[\w\-]+\s*:\s*[^;]+;\s*$
    | ^\s*@(?:media|import|font-face|keyframes|supports)\b
    | ^\s*\$[A-Za-z_]\w*
    | \w\([^)]*\)\s*[;{]?\s*$
""", re.X)
_OPTION_FLAG = re.compile(r"\s--?[A-Za-z][\w\-]*")


def _shell_line(line):
    words = line.strip().lstrip("$ ").split()
    if not words or len(words) > 14 or line.rstrip().endswith((".", "!", "?")):
        return False
    if words[0] in _SHELL_UNMISTAKABLE and 2 <= len(words) <= 8:
        return True
    if words[0] in _SHELL_COMMANDS and len(words) > 1:
        return words[0] == "sudo" or bool(_OPTION_FLAG.search(line)) or \
            bool(re.search(r"[/|>&~=]|\.\w", " ".join(words[1:])))
    return bool(_OPTION_FLAG.search(line)) and re.match(r"[\w./~\-]+$", words[0]) is not None


def _prose_line(line):
    words = line.split()
    return len(words) >= 8 and sum(word.strip(".,;:!?()\"'").isalpha() for word in words) >= 0.8 * len(words)


def looks_like_code(text):
    stripped = text.strip()
    if stripped.startswith(("#!", "<?php", "<?xml", "<!DOCTYPE", "<!doctype", "<html")):
        return True
    if stripped[:1] in "{[" and stripped[-1:] in "}]" and len(stripped) > 2:
        try:
            if isinstance(json.loads(stripped), (dict, list)):
                return True
        except ValueError:
            pass
    lines = [line for line in stripped.split("\n") if line.strip()][:200]
    if not lines:
        return False
    if all(_shell_line(line) for line in lines[:12]):
        return True
    code_lines = sum(1 for line in lines if _CODE_LINE.search(line) and not _prose_line(line))
    if len(lines) == 1:
        return code_lines == 1
    indented = sum(1 for line in lines if line.startswith(("  ", "\t")))
    if len(lines) >= 3 and indented >= len(lines) / 2 and code_lines:
        return True
    return code_lines >= 2 and code_lines >= 0.3 * len(lines)


_URL_LINE = re.compile(r"(?:(?:https?|s?ftp|file)://|www\.)\S+$", re.I)


def looks_like_url(text):
    """One web address, or a list with one address per line - and nothing else."""
    lines = [line.strip() for line in text.split("\n") if line.strip()]
    return 0 < len(lines) <= 100 and all(_URL_LINE.match(line) for line in lines)


def classify(text):
    """-> ("sensitive" | "url" | "code" | "text", spans to mask)"""
    sample = text[:ANALYSE_CHARS]
    spans = find_secrets(sample)
    if spans:
        return "sensitive", spans
    if looks_like_url(sample):
        return "url", ()
    return ("code" if looks_like_code(sample) else "text"), ()


_RICH = re.compile(r"<(?:b|strong|i|em|u|s|a|h[1-6]|ul|ol|li|table|tr|td|th|img|font|blockquote|code|pre"
                   r"|sup|sub|mark|br)\b|\s(?:style|class)\s*=", re.I)


def decode_html(data):
    """Clipboard text/html arrives as UTF-8 from some programs and UTF-16 from others."""
    if not data:
        return ""
    if data[:2] in (b"\xff\xfe", b"\xfe\xff"):
        return data.decode("utf-16", "replace")
    if b"\x00" in data[:400]:
        return data.decode("utf-16-le", "replace")
    return data.decode("utf-8", "replace")


def has_formatting(html):
    return bool(html) and bool(_RICH.search(html))


def html_for_clipboard(html):
    """Tell the receiving program the encoding; browsers and office suites need that."""
    if "charset" not in html[:1500].lower():
        html = '<meta http-equiv="content-type" content="text/html; charset=utf-8">' + html
    return html.encode("utf-8", "replace")


def relative_time(stamp, now=None):
    if stamp <= 0:
        return ""
    now = now or time.time()
    age = max(0, now - stamp)
    if age < 60:
        return _("t_now")
    if age < 3600:
        return _("t_min") % int(age // 60)
    day = datetime.date.fromtimestamp(stamp)
    days = (datetime.date.fromtimestamp(now) - day).days
    if days == 0 or age < 6 * 3600:
        return _("t_hour") % int(age // 3600)
    if days == 1:
        return _("t_yesterday")
    if days < 7:
        return _("t_days") % days
    return day.strftime(_("t_date"))


def monitor_key(monitor):
    geo = monitor.get_geometry()
    return "%s|%s|%dx%d+%d+%d" % (monitor.get_manufacturer() or "", monitor.get_model() or "",
                                  geo.width, geo.height, geo.x, geo.y)


