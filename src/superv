class SettingsWindow(Gtk.Window):
    """Edits a copy of the settings; nothing changes until "Save" is pressed."""

    SHORTCUTS = (("shift+insert", "Shift+Insert"), ("ctrl+v", "Ctrl+V"), ("ctrl+shift+v", "Ctrl+Shift+V"))

    def __init__(self, app):
        super().__init__(title="%s – %s" % (APP_NAME, _("settings")))
        self.app = app
        self.set_icon_name(APP_ID)
        self.set_resizable(False)
        self.set_border_width(18)
        self.set_position(Gtk.WindowPosition.CENTER)
        cfg = app.cfg

        grid = Gtk.Grid(column_spacing=18, row_spacing=12)
        self.add(grid)
        self._line = 0

        self.max_items = Gtk.SpinButton.new_with_range(5, 500, 5)
        self.max_items.set_value(cfg["max_items"])
        self._add(grid, "set_max_items", self.max_items)

        self.expire_days = Gtk.SpinButton.new_with_range(0, 3650, 1)
        self.expire_days.set_value(cfg["expire_days"])
        self._add(grid, "set_expire", self.expire_days)
        note = Gtk.Label(label=_("set_expire_note"), xalign=0)
        note.get_style_context().add_class("dim-label")
        grid.attach(note, 0, self._line, 2, 1)
        self._line += 1

        self.remember = Gtk.Switch(active=cfg["remember_position"])
        self._add(grid, "set_remember", self.remember)
        self.reset_positions = Gtk.Button(label=_("set_reset_pos"))
        self.reset_positions.set_halign(Gtk.Align.START)
        self.reset_positions.set_sensitive(bool(app.state["positions"]))
        self.reset_positions.connect("clicked", self._on_reset_positions)
        grid.attach(self.reset_positions, 0, self._line, 2, 1)
        self._line += 1

        self.paste = Gtk.Switch(active=cfg["paste_on_select"])
        self._add(grid, "set_paste", self.paste)

        self.shortcut = Gtk.ComboBoxText()
        for value, label in self.SHORTCUTS:
            self.shortcut.append(value, label)
        if not self.shortcut.set_active_id(cfg["paste_shortcut"].replace(" ", "").lower()):
            self.shortcut.set_active(0)
        self._add(grid, "set_shortcut", self.shortcut)

        self.formatted = Gtk.Switch(active=cfg["paste_formatted"])
        self._add(grid, "set_formatted", self.formatted)
        fnote = Gtk.Label(label=_("set_formatted_note"), xalign=0, wrap=True)
        fnote.set_max_width_chars(48)
        fnote.get_style_context().add_class("dim-label")
        grid.attach(fnote, 0, self._line, 2, 1)
        self._line += 1

        self.persist = Gtk.Switch(active=cfg["persist"])
        self._add(grid, "set_persist", self.persist)

        buttons = Gtk.Box(spacing=8)
        buttons.set_halign(Gtk.Align.END)
        buttons.set_margin_top(8)
        cancel = Gtk.Button(label=_("cancel"))
        cancel.connect("clicked", lambda *_a: self.destroy())
        save = Gtk.Button(label=_("save"))
        save.get_style_context().add_class("suggested-action")
        save.connect("clicked", self._on_save)
        buttons.pack_start(cancel, False, False, 0)
        buttons.pack_start(save, False, False, 0)
        grid.attach(buttons, 0, self._line, 2, 1)

        self.connect("key-press-event", self._on_key)
        grid.show_all()

    def _add(self, grid, label_key, control):
        label = Gtk.Label(label=_(label_key), xalign=0)
        label.set_hexpand(True)
        control.set_halign(Gtk.Align.END)
        control.set_valign(Gtk.Align.CENTER)
        grid.attach(label, 0, self._line, 1, 1)
        grid.attach(control, 1, self._line, 1, 1)
        self._line += 1

    def _on_key(self, _widget, event):
        if event.keyval == Gdk.KEY_Escape:
            self.destroy()
            return True
        return False

    def _on_reset_positions(self, button):
        self.app.state["positions"] = {}
        save_state(self.app.state)
        button.set_sensitive(False)

    def _on_save(self, *_args):
        self.max_items.update()
        self.expire_days.update()
        cfg = self.app.cfg
        cfg["max_items"] = self.max_items.get_value_as_int()
        cfg["expire_days"] = self.expire_days.get_value_as_int()
        cfg["remember_position"] = self.remember.get_active()
        cfg["paste_on_select"] = self.paste.get_active()
        cfg["paste_formatted"] = self.formatted.get_active()
        cfg["paste_shortcut"] = self.shortcut.get_active_id() or "shift+insert"
        cfg["persist"] = self.persist.get_active()
        save_config(cfg)
        self.app.store.apply_limits()
        self.destroy()


