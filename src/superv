class SuperV(Gtk.Application):
    TEXT_TARGETS = {"UTF8_STRING", "STRING", "TEXT", "COMPOUND_TEXT", "text/plain",
                    "text/plain;charset=utf-8"}
    SECRET_TARGET = "x-kde-passwordManagerHint"

    def __init__(self):
        super().__init__(application_id=APP_ID,
                         flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        GLib.set_prgname(APP_ID)
        GLib.set_application_name(APP_NAME)
        none = GLib.OptionArg.NONE
        for name, char, text in (
                ("toggle", "t", "Show or hide the history panel"),
                ("show", "s", "Show the history panel"),
                ("quit", "q", "Stop the background process"),
                ("setup-hotkey", 0, "Bind Super+V to the panel and exit"),
                ("remove-hotkey", 0, "Remove the Super+V binding and exit"),
                ("version", "v", "Print the version and exit")):
            self.add_main_option(name, ord(char) if char else 0, GLib.OptionFlags.NONE,
                                 none, text, None)
        self.cfg = None
        self.state = None
        self.store = None
        self.panel = None
        self.settings = None
        self.clipboard = None
        self.primary = None
        self.keyboard = VirtualKeyboard()
        self._read_source = 0
        self._interface = None
        self._has_html = False
        self._owner = None
        self._rich = None

    # -- startup ----------------------------------------------------------

    def do_handle_local_options(self, options):
        if options.contains("version"):
            print(APP_NAME, VERSION, "- by", AUTHOR)
            return 0
        if options.contains("setup-hotkey"):
            result = setup_hotkey()
            print("Super+V is now bound to SuperV." if result else
                  "No supported desktop found - bind '%s' to Super+V manually." % TOGGLE_COMMAND)
            return 0 if result else 1
        if options.contains("remove-hotkey"):
            remove_hotkey()
            print("Super+V binding removed.")
            return 0
        return -1

    def do_startup(self):
        Gtk.Application.do_startup(self)
        self.cfg = load_config()
        self.state = load_state()
        self.store = Store(self.cfg, self._on_store_changed)
        self.store.expire()
        GLib.timeout_add_seconds(3600, self._expire_tick)
        self.keyboard.open()

        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_USER + 10)
        self._follow_color_scheme()

        self.clipboard = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
        self.primary = Gtk.Clipboard.get(Gdk.SELECTION_PRIMARY)
        self.clipboard.connect("owner-change", lambda *_a: self._schedule_read())
        self._schedule_read()

        self.panel = Panel(self)

        for name, handler in (("toggle", self.toggle), ("show", self.show_panel),
                              ("quit", self.quit)):
            action = Gio.SimpleAction.new(name, None)
            action.connect("activate", lambda _action, _param, fn=handler: fn())
            self.add_action(action)

        self._first_run_hotkey()
        self.hold()

    def do_shutdown(self):
        if self.store is not None:
            self.store.save()
        self.keyboard.close()
        Gtk.Application.do_shutdown(self)

    def do_activate(self):
        self.show_panel()

    def do_command_line(self, command_line):
        options = command_line.get_options_dict()
        if options.contains("quit"):
            self.quit()
        elif options.contains("toggle"):
            self.toggle()
        elif options.contains("show"):
            self.show_panel()
        return 0

    def _first_run_hotkey(self):
        if os.path.exists(HOTKEY_MARKER):
            return
        try:
            result = setup_hotkey()
        except GLib.Error as err:
            log("hotkey setup failed:", err.message)
            return
        if result:
            try:
                os.makedirs(CONFIG_DIR, mode=0o700, exist_ok=True)
                with open(HOTKEY_MARKER, "w", encoding="utf-8") as handle:
                    handle.write(result + "\n")
            except OSError:
                pass

    def _follow_color_scheme(self):
        schema = _schema("org.gnome.desktop.interface")
        if not schema or not schema.has_key("color-scheme"):
            return
        self._interface = Gio.Settings.new("org.gnome.desktop.interface")

        def apply(*_args):
            dark = self._interface.get_string("color-scheme") == "prefer-dark"
            Gtk.Settings.get_default().set_property("gtk-application-prefer-dark-theme", dark)

        self._interface.connect("changed::color-scheme", apply)
        apply()

    # -- panel ------------------------------------------------------------

    def show_panel(self):
        self._schedule_read(10)
        self.panel.popup()

    def _expire_tick(self):
        self.store.expire()
        return True

    def open_settings(self):
        self.panel.hide()
        if self.settings is None:
            self.settings = SettingsWindow(self)
            self.settings.connect("destroy", self._on_settings_closed)
        self.settings.present()

    def _on_settings_closed(self, *_args):
        self.settings = None

    def toggle(self):
        if self.panel.get_visible():
            self.panel.hide()
        else:
            self.show_panel()

    def _on_store_changed(self):
        if self.panel is not None and self.panel.get_visible():
            self.panel.rebuild()

    # -- clipboard watching -----------------------------------------------

    def _schedule_read(self, delay=120):
        if self._read_source:
            GLib.source_remove(self._read_source)
        self._read_source = GLib.timeout_add(delay, self._read)

    def _read(self):
        self._read_source = 0
        self.clipboard.request_targets(self._on_targets)
        return False

    def _on_targets(self, clipboard, atoms, *_rest):
        names = {atom.name() for atom in atoms} if atoms else set()
        if not names or self.SECRET_TARGET in names:
            return  # empty, or flagged as a secret by a password manager
        if names & self.TEXT_TARGETS:
            self._has_html = "text/html" in names
            clipboard.request_text(self._on_text)
        elif any(name.startswith("image/") for name in names):
            clipboard.request_image(self._on_image)

    def _on_text(self, clipboard, text, *_rest):
        if not text:
            return
        if self._has_html:
            clipboard.request_contents(Gdk.Atom.intern("text/html", False), self._on_html, text)
        else:
            self.store.add_text(text)

    def _on_html(self, _clipboard, data, text):
        html = ""
        try:
            if data is not None and data.get_length() > 0:
                html = decode_html(bytes(data.get_data()))
        except (TypeError, ValueError):
            html = ""
        self.store.add_text(text, html)

    def _on_image(self, _clipboard, pixbuf, *_rest):
        if pixbuf is not None:
            self.store.add_image(pixbuf)

    # -- pasting ----------------------------------------------------------

    def can_paste(self):
        if not self.cfg["paste_on_select"]:
            return False
        if self.keyboard.open():
            return True
        return not session_is_wayland() and bool(shutil.which("xdotool"))

    def paste_item(self, item_id, formatted=None):
        """Paste an entry. formatted=None follows the setting, True/False forces it."""
        item = self.store.get(item_id)
        if item is None:
            return
        shortcut = self.cfg["paste_shortcut"].replace(" ", "").lower()
        if item.kind == "text":
            if formatted is None:
                formatted = self.cfg["paste_formatted"]
            if formatted and item.html:
                self._set_rich(item.text, item.html)
            else:
                self.clipboard.set_text(item.text, -1)
            if "insert" in shortcut:
                # Terminals paste the primary selection on Shift+Insert, every
                # other toolkit pastes the clipboard - so both carry the entry.
                self.primary.set_text(item.text, -1)
        else:
            try:
                self.clipboard.set_image(GdkPixbuf.Pixbuf.new_from_file(item.path))
            except GLib.Error as err:
                log("could not load image:", err.message)
                return
        self.store.touch(item.id)
        self._finish_paste(shortcut)

    def paste_text(self, text):
        """Paste text that was edited in the preview (plain; it becomes a new entry)."""
        shortcut = self.cfg["paste_shortcut"].replace(" ", "").lower()
        self.clipboard.set_text(text, -1)
        if "insert" in shortcut:
            self.primary.set_text(text, -1)
        self._finish_paste(shortcut)

    def _finish_paste(self, shortcut):
        self.panel.hide()
        if self.cfg["paste_on_select"]:
            # Give the previous window a moment to get its focus back (and a
            # just-created virtual keyboard a moment to be picked up).
            self.keyboard.open()
            GLib.timeout_add(max(220, self.keyboard.ready_in_ms()), self._send_paste, shortcut)

    def _set_rich(self, text, html):
        """Offer the clipboard as formatted (text/html) and plain text at once.

        Gtk.Clipboard.set_with_data is not available from Python, so a hidden
        widget takes ownership of the selection and answers the requests."""
        if self._owner is None:
            self._owner = Gtk.Invisible()
            self._owner.realize()
            self._owner.connect("selection-get", self._on_selection_get)
        self._rich = (text, html_for_clipboard(html))
        targets = [Gtk.TargetEntry.new("text/html", 0, 1)] + \
            [Gtk.TargetEntry.new(name, 0, 0) for name in
             ("UTF8_STRING", "text/plain;charset=utf-8", "text/plain", "STRING")]
        Gtk.selection_clear_targets(self._owner, Gdk.SELECTION_CLIPBOARD)
        Gtk.selection_add_targets(self._owner, Gdk.SELECTION_CLIPBOARD, targets)
        if not Gtk.selection_owner_set(self._owner, Gdk.SELECTION_CLIPBOARD, Gdk.CURRENT_TIME):
            log("could not offer formatted text, pasting it as plain text")
            self.clipboard.set_text(text, -1)

    def _on_selection_get(self, _widget, selection, info, _time):
        if self._rich is None:
            return
        text, payload = self._rich
        if info == 1:
            selection.set(Gdk.Atom.intern("text/html", False), 8, payload)
        else:
            selection.set_text(text, -1)

    def _send_paste(self, shortcut):
        if self.keyboard.open() and self.keyboard.send(shortcut):
            return False
        if not session_is_wayland() and shutil.which("xdotool"):
            keys = "+".join({"insert": "Insert"}.get(k, k) for k in shortcut.split("+"))
            subprocess.Popen(["xdotool", "key", "--clearmodifiers", keys])
        else:
            log("cannot simulate the paste shortcut (no access to /dev/uinput)")
        return False


def main():
    return SuperV().run(sys.argv)


if __name__ == "__main__":
    sys.exit(main())
