class VirtualKeyboard:
    """Tiny uinput keyboard used to send the paste shortcut.

    uinput works the same on X11 and Wayland. Access to /dev/uinput comes from
    the udev rule shipped with the package (seat user only).
    """

    UI_SET_EVBIT = 0x40045564
    UI_SET_KEYBIT = 0x40045565
    UI_DEV_SETUP = 0x405C5503
    UI_DEV_CREATE = 0x5501
    UI_DEV_DESTROY = 0x5502
    EV_SYN, EV_KEY = 0, 1
    BUS_VIRTUAL = 0x06
    KEYS = {"ctrl": 29, "shift": 42, "alt": 56, "v": 47, "insert": 110}

    def __init__(self):
        self.fd = None
        self.created_at = 0.0

    def open(self):
        if self.fd is not None:
            return True
        try:
            fd = os.open("/dev/uinput", os.O_WRONLY | os.O_NONBLOCK)
        except OSError:
            return False
        try:
            fcntl.ioctl(fd, self.UI_SET_EVBIT, self.EV_KEY)
            for code in self.KEYS.values():
                fcntl.ioctl(fd, self.UI_SET_KEYBIT, code)
            setup = struct.pack("HHHH80sI", self.BUS_VIRTUAL, 0x5356, 0x0001, 1,
                                b"SuperV virtual keyboard", 0)
            fcntl.ioctl(fd, self.UI_DEV_SETUP, setup)
            fcntl.ioctl(fd, self.UI_DEV_CREATE)
        except OSError as err:
            log("uinput setup failed:", err)
            os.close(fd)
            return False
        self.fd = fd
        self.created_at = time.monotonic()
        return True

    def close(self):
        if self.fd is not None:
            try:
                fcntl.ioctl(self.fd, self.UI_DEV_DESTROY)
            except OSError:
                pass
            os.close(self.fd)
            self.fd = None

    def _emit(self, ev_type, code, value):
        now = time.time()
        os.write(self.fd, struct.pack("llHHi", int(now), int((now % 1) * 1000000),
                                      ev_type, code, value))

    def ready_in_ms(self):
        """The compositor needs a moment to pick up a freshly created device."""
        return max(0, int((self.created_at + 0.6 - time.monotonic()) * 1000))

    def send(self, shortcut):
        codes = [self.KEYS[name] for name in shortcut.split("+") if name in self.KEYS]
        if not codes or self.fd is None:
            return False
        try:
            for code in codes:
                self._emit(self.EV_KEY, code, 1)
                self._emit(self.EV_SYN, 0, 0)
                time.sleep(0.008)
            for code in reversed(codes):
                self._emit(self.EV_KEY, code, 0)
                self._emit(self.EV_SYN, 0, 0)
                time.sleep(0.008)
        except OSError as err:
            log("uinput write failed:", err)
            return False
        return True


def session_is_wayland():
    return os.environ.get("XDG_SESSION_TYPE", "").lower() == "wayland" or \
        bool(os.environ.get("WAYLAND_DISPLAY"))


