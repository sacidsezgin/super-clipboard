MEDIA_SCHEMA = "org.gnome.settings-daemon.plugins.media-keys"
CUSTOM_SCHEMA = MEDIA_SCHEMA + ".custom-keybinding"
CUSTOM_PATH = "/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/superv/"
SHELL_SCHEMA = "org.gnome.shell.keybindings"
SHELL_KEY = "toggle-message-tray"
XFCE_PROPERTY = "/commands/custom/<Super>v"


def _schema(schema_id):
    source = Gio.SettingsSchemaSource.get_default()
    return source.lookup(schema_id, True) if source else None


def _is_xfce():
    return "xfce" in os.environ.get("XDG_CURRENT_DESKTOP", "").lower()


def setup_hotkey():
    """Bind Super+V to the toggle command. Returns a short status string."""
    if _is_xfce() and shutil.which("xfconf-query"):
        subprocess.call(["xfconf-query", "-c", "xfce4-keyboard-shortcuts", "-p", XFCE_PROPERTY,
                         "-n", "-t", "string", "-s", TOGGLE_COMMAND])
        return "xfce"
    if not (_schema(MEDIA_SCHEMA) and _schema(CUSTOM_SCHEMA)):
        return ""
    binding = Gio.Settings.new_with_path(CUSTOM_SCHEMA, CUSTOM_PATH)
    binding.set_string("name", "SuperV Clipboard History")
    binding.set_string("command", TOGGLE_COMMAND)
    binding.set_string("binding", "<Super>v")
    media = Gio.Settings.new(MEDIA_SCHEMA)
    paths = list(media.get_strv("custom-keybindings"))
    if CUSTOM_PATH not in paths:
        media.set_strv("custom-keybindings", paths + [CUSTOM_PATH])
    # GNOME uses Super+V for the notification list by default (Super+M stays).
    shell_schema = _schema(SHELL_SCHEMA)
    if shell_schema and shell_schema.has_key(SHELL_KEY):
        shell = Gio.Settings.new(SHELL_SCHEMA)
        current = list(shell.get_strv(SHELL_KEY))
        kept = [b for b in current if b.replace(" ", "").lower() != "<super>v"]
        if kept != current:
            shell.set_strv(SHELL_KEY, kept)
    Gio.Settings.sync()
    return "gnome"


def remove_hotkey():
    if _is_xfce() and shutil.which("xfconf-query"):
        subprocess.call(["xfconf-query", "-c", "xfce4-keyboard-shortcuts", "-p", XFCE_PROPERTY, "-r"])
    if _schema(MEDIA_SCHEMA) and _schema(CUSTOM_SCHEMA):
        media = Gio.Settings.new(MEDIA_SCHEMA)
        paths = list(media.get_strv("custom-keybindings"))
        if CUSTOM_PATH in paths:
            paths.remove(CUSTOM_PATH)
            media.set_strv("custom-keybindings", paths)
        binding = Gio.Settings.new_with_path(CUSTOM_SCHEMA, CUSTOM_PATH)
        for key in ("name", "command", "binding"):
            binding.reset(key)
        shell_schema = _schema(SHELL_SCHEMA)
        if shell_schema and shell_schema.has_key(SHELL_KEY):
            Gio.Settings.new(SHELL_SCHEMA).reset(SHELL_KEY)
        Gio.Settings.sync()
    try:
        os.unlink(HOTKEY_MARKER)
    except OSError:
        pass


