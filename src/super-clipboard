MEDIA_SCHEMA = "org.gnome.settings-daemon.plugins.media-keys"
CUSTOM_SCHEMA = MEDIA_SCHEMA + ".custom-keybinding"
CUSTOM_PATH = "/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/super-clipboard/"
LEGACY_CUSTOM_PATH = "/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/superv/"
LEGACY_TOGGLE_COMMAND = "/usr/bin/superv-toggle"
SHELL_SCHEMA = "org.gnome.shell.keybindings"
SHELL_KEY = "toggle-message-tray"
DEFAULT_HOTKEY = "<Super>v"
XFCE_PROPERTY_PREFIX = "/commands/custom/"


def _schema(schema_id):
    source = Gio.SettingsSchemaSource.get_default()
    return source.lookup(schema_id, True) if source else None


def xfce_property(accel):
    return XFCE_PROPERTY_PREFIX + accel


def normalize_accel(accel):
    """'<shift><Super>V' -> '<Shift><Super>v' (canonical GTK form); '' if invalid."""
    key, mods = Gtk.accelerator_parse(accel or "")
    if not key or not Gtk.accelerator_valid(key, mods):
        return ""
    return Gtk.accelerator_name(key, mods)


def accel_label(accel):
    """'<Super>v' -> 'Super+V' for display."""
    key, mods = Gtk.accelerator_parse(accel)
    return Gtk.accelerator_get_label(key, mods) if key else accel


def _is_xfce():
    return "xfce" in os.environ.get("XDG_CURRENT_DESKTOP", "").lower()


def migrate_legacy_hotkey():
    """Drop the Super+V binding left behind by the old "SuperV" package.

    It points at a command that no longer exists and claims the same key, so
    it would shadow the new binding. Returns True if something was removed.
    """
    removed = False
    if _is_xfce() and shutil.which("xfconf-query"):
        prop = xfce_property(DEFAULT_HOTKEY)
        old = subprocess.run(["xfconf-query", "-c", "xfce4-keyboard-shortcuts", "-p", prop],
                             capture_output=True, text=True).stdout.strip()
        if old == LEGACY_TOGGLE_COMMAND:
            subprocess.call(["xfconf-query", "-c", "xfce4-keyboard-shortcuts", "-p", prop, "-r"])
            removed = True
    if _schema(MEDIA_SCHEMA) and _schema(CUSTOM_SCHEMA):
        media = Gio.Settings.new(MEDIA_SCHEMA)
        paths = list(media.get_strv("custom-keybindings"))
        if LEGACY_CUSTOM_PATH in paths:
            paths.remove(LEGACY_CUSTOM_PATH)
            media.set_strv("custom-keybindings", paths)
            binding = Gio.Settings.new_with_path(CUSTOM_SCHEMA, LEGACY_CUSTOM_PATH)
            for key in ("name", "command", "binding"):
                binding.reset(key)
            removed = True
        Gio.Settings.sync()
    return removed


def setup_hotkey(accel=DEFAULT_HOTKEY, previous=None, regrab=False):
    """Bind accel (a GTK accelerator such as "<Super>v") to the toggle command.

    Returns a short status string ("" if the desktop is not supported).
    previous: the accelerator bound before, so Xfce can drop that entry.
    regrab: gsd-media-keys does not retry a key grab that failed while the old
    binding still held the key, so clear and re-set the key to make it try again.
    """
    if _is_xfce() and shutil.which("xfconf-query"):
        if previous and previous != accel:
            subprocess.call(["xfconf-query", "-c", "xfce4-keyboard-shortcuts",
                             "-p", xfce_property(previous), "-r"])
        subprocess.call(["xfconf-query", "-c", "xfce4-keyboard-shortcuts", "-p", xfce_property(accel),
                         "-n", "-t", "string", "-s", TOGGLE_COMMAND])
        return "xfce"
    if not (_schema(MEDIA_SCHEMA) and _schema(CUSTOM_SCHEMA)):
        return ""
    binding = Gio.Settings.new_with_path(CUSTOM_SCHEMA, CUSTOM_PATH)
    binding.set_string("name", "Super Clipboard History")
    binding.set_string("command", TOGGLE_COMMAND)
    if regrab:
        binding.set_string("binding", "")
        Gio.Settings.sync()
        time.sleep(0.5)
    binding.set_string("binding", accel)
    media = Gio.Settings.new(MEDIA_SCHEMA)
    paths = list(media.get_strv("custom-keybindings"))
    if CUSTOM_PATH not in paths:
        media.set_strv("custom-keybindings", paths + [CUSTOM_PATH])
    # GNOME uses Super+V for the notification list by default (Super+M stays).
    shell_schema = _schema(SHELL_SCHEMA)
    if shell_schema and shell_schema.has_key(SHELL_KEY) and accel.lower() == DEFAULT_HOTKEY:
        shell = Gio.Settings.new(SHELL_SCHEMA)
        current = list(shell.get_strv(SHELL_KEY))
        kept = [b for b in current if b.replace(" ", "").lower() != DEFAULT_HOTKEY]
        if kept != current:
            shell.set_strv(SHELL_KEY, kept)
    Gio.Settings.sync()
    return "gnome"


def remove_hotkey(accel=DEFAULT_HOTKEY):
    if _is_xfce() and shutil.which("xfconf-query"):
        subprocess.call(["xfconf-query", "-c", "xfce4-keyboard-shortcuts", "-p", xfce_property(accel), "-r"])
    if _schema(MEDIA_SCHEMA) and _schema(CUSTOM_SCHEMA):
        media = Gio.Settings.new(MEDIA_SCHEMA)
        paths = list(media.get_strv("custom-keybindings"))
        if CUSTOM_PATH in paths:
            paths.remove(CUSTOM_PATH)
            media.set_strv("custom-keybindings", paths)
        binding = Gio.Settings.new_with_path(CUSTOM_SCHEMA, CUSTOM_PATH)
        for key in ("name", "command", "binding"):
            binding.reset(key)
        shell_schema = _schema(SHELL_SCHEMA)
        if shell_schema and shell_schema.has_key(SHELL_KEY):
            Gio.Settings.new(SHELL_SCHEMA).reset(SHELL_KEY)
        Gio.Settings.sync()
    try:
        os.unlink(HOTKEY_MARKER)
    except OSError:
        pass


# -------------------------------------------------------------- updates ----
# Every release is published on GitHub with the .deb attached. The background
# process looks for a newer one shortly after it starts and then every 12 hours.
# Installing runs a small root helper through pkexec, which asks for an
# administrator password, and then starts the new version.

UPDATE_REPO = "sacidsezgin/super-clipboard"
UPDATE_API = "https://api.github.com/repos/%s/releases/latest" % UPDATE_REPO
UPDATE_PAGE = "https://github.com/%s/releases/latest" % UPDATE_REPO
UPDATE_DOWNLOADS = "https://github.com/%s/releases/download/" % UPDATE_REPO
UPDATE_HELPER = "/usr/lib/super-clipboard/install-update"
UPDATE_DIR = os.path.join(GLib.get_user_cache_dir(), "super-clipboard", "updates")
UPDATE_LOG = os.path.join(UPDATE_DIR, "install.log")
UPDATE_FIRST_CHECK = 90            # seconds after startup
UPDATE_INTERVAL = 12 * 3600        # seconds between two automatic checks
UPDATE_MAX_BYTES = 50 * 1024 * 1024
UPDATE_ERRORS = (OSError, ValueError, KeyError, TypeError, AttributeError, http.client.HTTPException)

# Runs detached, so it outlives this process, which the upgrade stops (prerm):
# install, make sure the old process is gone, then start the new version.
UPDATE_SCRIPT = """
pkexec "$1" "$2" || exit $?
gdbus call --session --timeout 3 --dest "$3" --object-path "$4" \\
    --method org.gtk.Actions.Activate quit '[]' '{}' >/dev/null 2>&1
sleep 1
exec /usr/bin/super-clipboard
"""


class UpdateError(Exception):
    pass


def parse_version(text):
    """'v1.6.0' or '1.6.0' -> (1, 6, 0); None if it is no version number."""
    match = re.match(r"v?(\d+)\.(\d+)\.(\d+)", text.strip()) if isinstance(text, str) else None
    return tuple(int(part) for part in match.groups()) if match else None


CURRENT_VERSION = parse_version(VERSION) or (0, 0, 0)


def _http_get(url, timeout):
    request = urllib.request.Request(url, headers={
        "User-Agent": "super-clipboard/" + VERSION,
        "Accept": "application/vnd.github+json" if url == UPDATE_API else "*/*",
    })
    return urllib.request.urlopen(request, timeout=timeout)


def error_text(err):
    if isinstance(err, urllib.error.HTTPError):
        return "HTTP %d %s" % (err.code, err.reason)
    if isinstance(err, urllib.error.URLError):
        return str(err.reason)
    return str(err) or err.__class__.__name__


def fetch_latest_release():
    """Ask GitHub for the newest release (blocking): a dict, None if there is none yet."""
    try:
        with _http_get(UPDATE_API, 20) as response:
            release = json.loads(response.read(2 * 1024 * 1024).decode("utf-8"))
    except urllib.error.HTTPError as err:
        if err.code == 404:
            return None
        raise
    version = parse_version(release.get("tag_name"))
    if version is None:
        raise UpdateError("the latest release has no version number")
    name = "super-clipboard_%d.%d.%d_all.deb" % version
    assets = {asset.get("name"): asset for asset in release.get("assets") or () if isinstance(asset, dict)}
    deb = assets.get(name) or {}
    digest = deb.get("digest") or ""
    page = release.get("html_url") or ""
    return {
        "version": version,
        "label": "%d.%d.%d" % version,
        "page": page if page.startswith("https://github.com/") else UPDATE_PAGE,
        "url": deb.get("browser_download_url"),
        "sha256": digest[7:].lower() if digest.startswith("sha256:") else None,
        "sha256_url": (assets.get(name + ".sha256") or {}).get("browser_download_url"),
    }


def download_release(release):
    """Download the release's .deb (blocking), check its SHA-256, return its path."""
    def official(url):
        return isinstance(url, str) and url.startswith(UPDATE_DOWNLOADS)

    if not official(release["url"]):
        raise UpdateError("the release has no .deb package")
    expected = release["sha256"]
    if not expected and official(release["sha256_url"]):
        with _http_get(release["sha256_url"], 20) as response:
            words = response.read(4096).decode("ascii", "replace").split()
        expected = words[0].lower() if words else ""
    if not expected or not re.fullmatch(r"[0-9a-f]{64}", expected):
        raise UpdateError("the release has no checksum")
    os.makedirs(UPDATE_DIR, mode=0o700, exist_ok=True)
    for old in os.listdir(UPDATE_DIR):
        if old.endswith((".deb", ".part")):
            os.unlink(os.path.join(UPDATE_DIR, old))
    path = os.path.join(UPDATE_DIR, "super-clipboard_%s_all.deb" % release["label"])
    digest = hashlib.sha256()
    size = 0
    with _http_get(release["url"], 60) as response, open(path + ".part", "wb") as out:
        while True:
            chunk = response.read(65536)
            if not chunk:
                break
            size += len(chunk)
            if size > UPDATE_MAX_BYTES:
                raise UpdateError("the download is too large")
            digest.update(chunk)
            out.write(chunk)
    if digest.hexdigest() != expected:
        os.unlink(path + ".part")
        raise UpdateError("the download is damaged (checksum mismatch)")
    os.replace(path + ".part", path)
    return path


class Updater:
    """Finds newer releases and installs them on request.

    status is one of "idle", "checking", "current", "available", "failed"
    (the check), "downloading", "installing", "install_failed". Network work
    runs in a thread; its result comes back to the main loop via GLib.idle_add.
    Listeners are called on every change."""

    BUSY = ("checking", "downloading", "installing")

    def __init__(self, app):
        self.app = app
        self.status = "idle"
        self.release = None          # the newer release, once one was found
        self.error = ""
        self.listeners = []
        self._last_check = None
        self._install_after_check = False

    @property
    def busy(self):
        return self.status in self.BUSY

    def start(self):
        GLib.timeout_add_seconds(UPDATE_FIRST_CHECK, self._first_tick)
        GLib.timeout_add_seconds(3600, self._hourly_tick)

    def _first_tick(self):
        self._maybe_check()
        return False

    def _hourly_tick(self):
        self._maybe_check()
        return True

    def _maybe_check(self):
        # Wall-clock time, so a laptop that sleeps a lot still checks twice a day.
        due = self._last_check is None or not 0 <= time.time() - self._last_check < UPDATE_INTERVAL
        if self.app.cfg["check_updates"] and due:
            self.check()

    def _set(self, status):
        self.status = status
        for listener in list(self.listeners):
            listener()

    def _in_thread(self, work, done, failed, *args):
        def run():
            try:
                result = work(*args)
            except Exception as err:  # noqa: BLE001 - every failure must reach the UI, or it stays "busy"
                GLib.idle_add(failed, error_text(err))
            else:
                GLib.idle_add(done, result)
        threading.Thread(target=run, daemon=True).start()

    # -- checking -----------------------------------------------------------

    def check(self, install=False):
        if self.busy:
            return
        self._last_check = time.time()
        self._install_after_check = install
        self._set("checking")
        self._in_thread(fetch_latest_release, self._on_checked, self._on_check_failed)

    def _on_checked(self, release):
        if release is not None and release["version"] > CURRENT_VERSION:
            self.release = release
            self._set("available")
            self._notify_available()
            if self._install_after_check:
                self.install()
        else:
            self.release = None
            self._set("current")

    def _on_check_failed(self, error):
        log("update check failed:", error)
        if self._install_after_check:   # "Update" was pressed: say why nothing happens
            self._on_install_failed(error)
            return
        self.error = error
        self._set("available" if self.release else "failed")

    def _notify_available(self):
        label = self.release["label"]
        if self.app.state.get("update_notified") == label:
            return
        self.app.state["update_notified"] = label
        save_state(self.app.state)
        note = Gio.Notification.new(_("upd_note_title") % label)
        note.set_body(_("upd_note_body"))
        note.set_icon(Gio.ThemedIcon.new(APP_ID))
        note.set_default_action("app.show")
        note.add_button(_("upd_install"), "app.install-update")
        self.app.send_notification("update", note)

    # -- installing ---------------------------------------------------------

    def install(self):
        if self.busy:
            return
        if self.release is None:
            self.check(install=True)
            return
        if not (os.access(UPDATE_HELPER, os.X_OK) and shutil.which("pkexec")):
            self.open_release_page()    # not installed as a package: let the user download it
            return
        self.app.withdraw_notification("update")
        self._set("downloading")
        self._in_thread(self._download_and_install, self._on_installed, self._on_install_failed,
                        self.release)

    def _download_and_install(self, release):
        """Runs in the worker thread; returns the exit status of the install."""
        path = download_release(release)
        GLib.idle_add(self._set, "installing")
        # Output goes to a file, not a pipe: the install outlives this process.
        with open(UPDATE_LOG, "wb") as output:
            return subprocess.call(["/bin/sh", "-c", UPDATE_SCRIPT, "sh", UPDATE_HELPER, path, APP_ID, APP_PATH],
                                   stdin=subprocess.DEVNULL, stdout=output, stderr=subprocess.STDOUT,
                                   start_new_session=True)

    def _on_installed(self, code):
        if code == 0:
            # Normally the upgrade has stopped this process already; if not, hand over.
            subprocess.Popen(["/bin/sh", "-c", "sleep 1; exec /usr/bin/super-clipboard"],
                             stdin=subprocess.DEVNULL, start_new_session=True)
            self.app.quit()
        elif code == 126:               # the password dialog was dismissed
            self._set("available")
        else:
            self._on_install_failed(self._log_tail() or
                                    (_("upd_not_allowed") if code == 127 else "exit status %d" % code))

    def _on_install_failed(self, error):
        log("update failed:", error)
        self.error = error
        self._set("install_failed")
        note = Gio.Notification.new(_("upd_failed_title"))
        note.set_body(error)
        note.set_icon(Gio.ThemedIcon.new(APP_ID))
        note.set_default_action("app.show")
        self.app.send_notification("update", note)

    @staticmethod
    def _log_tail():
        try:
            with open(UPDATE_LOG, encoding="utf-8", errors="replace") as handle:
                lines = [line.strip() for line in handle if line.strip()]
        except OSError:
            return ""
        return lines[-1][:200] if lines else ""

    def open_release_page(self):
        page = self.release["page"] if self.release else UPDATE_PAGE
        try:
            Gtk.show_uri_on_window(None, page, Gdk.CURRENT_TIME)
        except GLib.Error as err:
            log("could not open %s:" % page, err.message)

    # -- text for the panel and the settings window -------------------------

    def text(self, markup=False):
        label = self.release["label"] if self.release else ""
        if markup and self.status == "available" and self.release:
            link = '<a href="%s">%s</a>' % (GLib.markup_escape_text(self.release["page"]), label)
            return GLib.markup_escape_text(_("upd_available")) % link
        text = {
            "idle": _("upd_idle") % VERSION,
            "checking": _("upd_checking"),
            "current": _("upd_current") % VERSION,
            "failed": _("upd_failed") % self.error,
            "available": _("upd_available") % label,
            "downloading": _("upd_downloading") % label,
            "installing": _("upd_installing") % label,
            "install_failed": _("upd_install_failed") % self.error,
        }[self.status]
        return GLib.markup_escape_text(text) if markup else text


