    def _add(self, grid, label_key, control):
        label = Gtk.Label(label=_(label_key), xalign=0)
        label.set_hexpand(True)
        control.set_halign(Gtk.Align.END)
        control.set_valign(Gtk.Align.CENTER)
        grid.attach(label, 0, self._line, 1, 1)
        grid.attach(control, 1, self._line, 1, 1)
        self._line += 1

    def _on_key(self, _widget, event):
        if self._capturing:
            self._capture_key(event)
            return True
        if event.keyval == Gdk.KEY_Escape:
            self.destroy()
            return True
        return False

    # -- shortcut capture ---------------------------------------------------

    _MODIFIER_KEYS = {
        Gdk.KEY_Shift_L, Gdk.KEY_Shift_R, Gdk.KEY_Control_L, Gdk.KEY_Control_R,
        Gdk.KEY_Alt_L, Gdk.KEY_Alt_R, Gdk.KEY_Meta_L, Gdk.KEY_Meta_R,
        Gdk.KEY_Super_L, Gdk.KEY_Super_R, Gdk.KEY_Hyper_L, Gdk.KEY_Hyper_R,
        Gdk.KEY_ISO_Level3_Shift, Gdk.KEY_ISO_Level5_Shift, Gdk.KEY_Mode_switch,
        Gdk.KEY_Caps_Lock, Gdk.KEY_Num_Lock, Gdk.KEY_Scroll_Lock,
    }
    # Without one of these a plain key press would be taken away from normal typing.
    _TYPING_SAFE_MODS = (Gdk.ModifierType.CONTROL_MASK | Gdk.ModifierType.MOD1_MASK |
                         Gdk.ModifierType.SUPER_MASK | Gdk.ModifierType.HYPER_MASK |
                         Gdk.ModifierType.META_MASK)

    def _set_hotkey(self, accel):
        self.hotkey = accel
        self.hotkey_button.set_label(accel_label(accel))
        self.hotkey_reset.set_sensitive(accel != DEFAULT_HOTKEY)
        self.hotkey_note.hide()

    def _on_hotkey_clicked(self, _button):
        if self._capturing:
            self._end_capture()
            return
        self._capturing = True
        self.hotkey_button.set_label(_("hotkey_press"))
        self.hotkey_note.hide()
        # Grab the keyboard so Super+<key> reaches this window instead of the desktop.
        gdk_window = self.get_window()
        if gdk_window is not None:
            seat = gdk_window.get_display().get_default_seat()
            status = seat.grab(gdk_window, Gdk.SeatCapabilities.KEYBOARD, False, None, None, None)
            if status == Gdk.GrabStatus.SUCCESS:
                self._grab_seat = seat

    def _end_capture(self):
        if not self._capturing:
            return
        self._capturing = False
        if self._grab_seat is not None:
            self._grab_seat.ungrab()
            self._grab_seat = None
        self.hotkey_button.set_label(accel_label(self.hotkey))

    def _capture_key(self, event):
        if event.keyval in self._MODIFIER_KEYS:
            return
        mods = event.state & Gtk.accelerator_get_default_mod_mask()
        if event.keyval == Gdk.KEY_Escape and not mods:
            self._end_capture()
            return
        # The key without Shift etc. applied: Shift+1 is "<Shift>1", not "<Shift>exclam".
        found, keyval, _group, _level, _consumed = Gdk.Keymap.get_for_display(
            self.get_display()).translate_keyboard_state(event.hardware_keycode, 0, event.group)
        keyval = Gdk.keyval_to_lower(keyval if found else event.keyval)
        is_function_key = Gdk.KEY_F1 <= keyval <= Gdk.KEY_F35
        if not (mods & self._TYPING_SAFE_MODS) and not is_function_key:
            self.hotkey_note.set_text(_("hotkey_need_mod"))
            self.hotkey_note.show()
            return
        accel = normalize_accel(Gtk.accelerator_name(keyval, mods))
        if not accel:
            self.hotkey_note.set_text(_("hotkey_need_mod"))
            self.hotkey_note.show()
            return
        self._end_capture()
        self._set_hotkey(accel)

    def _refresh_update(self):
        updater = self.app.updater
        self.update_status.set_markup(updater.text(markup=True))
        if updater.release is not None and updater.status in ("available", "install_failed"):
            self.update_button.set_label(_("upd_install_to") % updater.release["label"])
        else:
            self.update_button.set_label(_("upd_check"))
        self.update_button.set_sensitive(not updater.busy)

    def _on_update_clicked(self, _button):
        updater = self.app.updater
        if updater.release is not None and updater.status in ("available", "install_failed"):
            updater.install()
        else:
            updater.check()

    def _on_reset_positions(self, button):
        self.app.state["positions"] = {}
        save_state(self.app.state)
        button.set_sensitive(False)

    def _on_save(self, *_args):
        self.max_items.update()
        self.expire_days.update()
        cfg = self.app.cfg
        cfg["max_items"] = self.max_items.get_value_as_int()
        cfg["expire_days"] = self.expire_days.get_value_as_int()
        cfg["remember_position"] = self.remember.get_active()
        cfg["paste_on_select"] = self.paste.get_active()
        cfg["paste_formatted"] = self.formatted.get_active()
        cfg["paste_shortcut"] = self.shortcut.get_active_id() or "shift+insert"
        cfg["persist"] = self.persist.get_active()
        cfg["check_updates"] = self.check_updates.get_active()
        language = self.language.get_active_id() or "auto"
        language_changed = language != cfg["language"]
        cfg["language"] = language
        previous = configured_hotkey(cfg)
        cfg["hotkey"] = self.hotkey
        save_config(cfg)
        self.app.store.apply_limits()
        if self.hotkey != previous:
            self.app.change_hotkey(previous, self.hotkey, self)
        self.destroy()
        if language_changed:
            self.app.apply_language()


