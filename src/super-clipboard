class Item:
    __slots__ = ("id", "kind", "text", "pinned", "pinned_at", "ts", "category", "spans", "html")

    def __init__(self, item_id, kind, text="", pinned=False, ts=None, html=""):
        self.html = html           # formatted version (text/html) if the copy had one
        self.id = item_id
        self.kind = kind          # "text" or "image"
        self.text = text          # only for kind == "text"
        self.pinned = pinned
        self.pinned_at = 0.0      # when it was pinned (0 = unknown, e.g. pinned by an older version)
        self.ts = ts or time.time()
        if kind == "text":
            self.category, self.spans = classify(text)   # "text", "code", "url" or "sensitive"
        else:
            self.category, self.spans = "image", ()

    @property
    def display_text(self):
        """What the list shows: the text with its sensitive parts masked."""
        sample = self.text[:4000]
        return masked_text(sample, [(a, min(b, len(sample))) for a, b in self.spans if a < len(sample)])

    @property
    def path(self):
        return os.path.join(IMAGE_DIR, self.id + ".png")

    def to_dict(self):
        data = {"id": self.id, "kind": self.kind, "pinned": self.pinned, "ts": self.ts}
        if self.pinned:
            data["pinned_at"] = self.pinned_at
        if self.kind == "text":
            data["text"] = self.text
            if self.html:
                data["html"] = self.html
        return data


class Store:
    """History, newest first. Pinned entries are never evicted."""

    def __init__(self, cfg, on_change):
        self.cfg = cfg
        self.on_change = on_change
        self.items = []
        self._save_source = 0
        os.makedirs(IMAGE_DIR, mode=0o700, exist_ok=True)
        os.chmod(DATA_DIR, 0o700)
        if cfg["persist"]:
            self._load()
        self._drop_orphan_images()

    def _load(self):
        try:
            with open(HISTORY_FILE, encoding="utf-8") as handle:
                raw = json.load(handle)
        except FileNotFoundError:
            return
        except (OSError, ValueError) as err:
            log("history unreadable, starting empty:", err)
            return
        for entry in raw.get("items", []) if isinstance(raw, dict) else []:
            try:
                html = entry.get("html", "")
                item = Item(str(entry["id"]), entry["kind"], entry.get("text", ""),
                            bool(entry.get("pinned")), float(entry.get("ts", 0)),
                            html if isinstance(html, str) else "")
                if item.pinned:
                    item.pinned_at = float(entry.get("pinned_at", 0))
            except (KeyError, TypeError, ValueError):
                continue
            if not item.id.isalnum() or item.kind not in ("text", "image"):
                continue
            if item.kind == "image" and not os.path.isfile(item.path):
                continue
            self.items.append(item)

    def _drop_orphan_images(self):
        known = {item.id + ".png" for item in self.items if item.kind == "image"}
        try:
            for name in os.listdir(IMAGE_DIR):
                if name not in known:
                    os.unlink(os.path.join(IMAGE_DIR, name))
        except OSError:
            pass

    def save(self):
        self._save_source = 0
        if not self.cfg["persist"]:
            return False
        tmp = HISTORY_FILE + ".tmp"
        try:
            fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
            with os.fdopen(fd, "w", encoding="utf-8") as handle:
                json.dump({"version": 1, "items": [i.to_dict() for i in self.items]},
                          handle, ensure_ascii=False)
            os.replace(tmp, HISTORY_FILE)
        except OSError as err:
            log("could not save history:", err)
        return False

    def _changed(self):
        if not self._save_source:
            self._save_source = GLib.timeout_add(400, self.save)
        self.on_change()

    def get(self, item_id):
        for item in self.items:
            if item.id == item_id:
                return item
        return None

    def _insert(self, item):
        existing = self.get(item.id)
        if existing is not None:
            if item.html and not existing.html:
                existing.html = item.html          # the same text, now with formatting
            if self.items[0] is existing:
                existing.ts = item.ts      # copied again: refresh "copied ... ago"
                self._changed()
                return
            if not item.html:
                item.html = existing.html
            self.items.remove(existing)
            item.pinned = existing.pinned
            item.pinned_at = existing.pinned_at
        self.items.insert(0, item)
        self._trim()
        self._changed()

    def _trim(self):
        unpinned = [i for i in self.items if not i.pinned]
        for item in unpinned[self.cfg["max_items"]:]:
            self.items.remove(item)
            self._unlink(item)

    @staticmethod
    def _unlink(item):
        if item.kind == "image":
            try:
                os.unlink(item.path)
            except OSError:
                pass

    def add_text(self, text, html=""):
        if not text or not text.strip() or len(text) > self.cfg["max_text_chars"]:
            return
        if not has_formatting(html) or len(html) > self.cfg["max_html_chars"]:
            html = ""
        digest = hashlib.sha256(text.encode("utf-8", "surrogatepass")).hexdigest()[:40]
        self._insert(Item("t" + digest, "text", text, html=html))

    def add_image(self, pixbuf):
        width, height = pixbuf.get_width(), pixbuf.get_height()
        if width < 1 or height < 1 or width * height > self.cfg["max_image_pixels"]:
            return
        sha = hashlib.sha256()
        sha.update(("%dx%dx%d" % (width, height, pixbuf.get_n_channels())).encode())
        sha.update(pixbuf.get_pixels())
        item = Item("i" + sha.hexdigest()[:40], "image")
        if not os.path.isfile(item.path):
            try:
                pixbuf.savev(item.path, "png", [], [])
                os.chmod(item.path, 0o600)
            except GLib.Error as err:
                log("could not store image:", err.message)
                return
        self._insert(item)

    def touch(self, item_id):
        item = self.get(item_id)
        if item is not None and self.items[0] is not item:
            self.items.remove(item)
            self.items.insert(0, item)
            item.ts = time.time()
            self._changed()

    def remove(self, item_id):
        item = self.get(item_id)
        if item is not None:
            self.items.remove(item)
            self._unlink(item)
            self._changed()

    def toggle_pin(self, item_id):
        item = self.get(item_id)
        if item is not None:
            item.pinned = not item.pinned
            item.pinned_at = time.time() if item.pinned else 0.0
            self._trim()
            self._changed()

    def clear_unpinned(self):
        for item in [i for i in self.items if not i.pinned]:
            self.items.remove(item)
            self._unlink(item)
        self._changed()

    def expire(self):
        """Drop unpinned entries older than cfg["expire_days"] (0 = keep forever)."""
        days = self.cfg["expire_days"]
        if days <= 0:
            return
        limit = time.time() - days * 86400
        old = [i for i in self.items if not i.pinned and 0 < i.ts < limit]
        for item in old:
            self.items.remove(item)
            self._unlink(item)
        if old:
            self._changed()

    def apply_limits(self):
        self._trim()
        self.expire()
        self._changed()


