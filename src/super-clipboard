DEFAULT_LANGUAGE = "en"   # used for every system language that has no translation


def _lang_code(value):
    """'de_DE.UTF-8' -> 'de'; '' for unset, C and POSIX."""
    code = value.strip().split(".")[0].split("@")[0].split("_")[0].lower()
    return "" if code in ("c", "posix") else code


def _pick_language():
    """Follow the system language: German if it is German, English otherwise.

    Mirrors gettext: the locale comes from LC_ALL, LC_MESSAGES, LANG (the first
    one that is set); LANGUAGE may list preferences ("pt:de") and the first
    translated one wins. The C/POSIX locale always means the default language.
    """
    locale_value = ""
    for var in ("LC_ALL", "LC_MESSAGES", "LANG"):
        locale_value = os.environ.get(var, "")
        if locale_value:
            break
    if not locale_value:
        try:
            locale_value = locale.getlocale()[0] or ""
        except (ValueError, TypeError):
            locale_value = ""
    primary = _lang_code(locale_value)
    if not primary:
        return DEFAULT_LANGUAGE
    for entry in os.environ.get("LANGUAGE", "").split(":"):
        code = _lang_code(entry)
        if code in STRINGS:
            return code
    return primary if primary in STRINGS else DEFAULT_LANGUAGE


LANGUAGE_NAMES = (("en", "English"), ("de", "Deutsch"))   # always shown in their own language
