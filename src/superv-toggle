#!/bin/sh
# Run by the Super+V shortcut. Asks the running SuperV process over D-Bus to
# show or hide its panel (fast); if it is not running yet, starts it.
gdbus call --session --dest org.superv.Clipboard \
    --object-path /org/superv/Clipboard \
    --method org.gtk.Actions.Activate toggle '[]' '{}' >/dev/null 2>&1 && exit 0
exec /usr/bin/superv --toggle
