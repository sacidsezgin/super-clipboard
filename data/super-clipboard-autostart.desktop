[Desktop Entry]
Type=Application
Name=Super Clipboard
Comment=Watches the clipboard and keeps its history
Comment[de]=Beobachtet die Zwischenablage und merkt sich den Verlauf
Exec=super-clipboard
Icon=org.super_clipboard.Clipboard
Terminal=false
NoDisplay=true
X-GNOME-Autostart-enabled=true
X-GNOME-Autostart-Delay=2
